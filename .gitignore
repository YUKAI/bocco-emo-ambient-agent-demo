# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
dist/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]
__pycache__/

# Python virtualenvs and test caches (bridge/)
# `.venv*/` rather than `.venv/`: the replication guide tells the reader to
# build a throwaway `.venv-test` before transferring a pinned revision to the Pi.
.venv*/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# Raspberry Pi image build (生成イメージと機密入り cloud-init 実体)
raspberry-img/deploy/
raspberry-img/cloud-init/user-data
raspberry-img/cloud-init/network-config

# Secrets
#
# The bridge defaults its OAuth token file to oauth.json beside its database,
# and its database path is only absolute once the service environment file is
# loaded. Running it from a checkout without BOCCO_BRIDGE_DB set therefore
# drops state.db, memory.db, transcript.db, repertoire.db and — critically —
# an oauth.json holding live BOCCO access and refresh tokens into the working
# tree. These patterns exist so that one `git add .` cannot publish them.
.env
*.env
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
oauth*.json
# The token store writes atomically: it creates a `mkstemp` temporary file in
# the same directory and renames it over oauth.json. That temporary is named
# `.oauth.json.<random>` — a leading dot and a trailing suffix, so the two
# patterns above miss it — and while it exists it holds a live access token and
# a live refresh token. A crash between create and rename leaves it behind.
.oauth*.json*

# Local setup state
.env.local
.secrets-pending
