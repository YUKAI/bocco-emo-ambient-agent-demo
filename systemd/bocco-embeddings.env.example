# Install as /etc/bocco-embeddings/embeddings.env with owner root:bocco-embeddings
# and mode 0640. There are no secrets here — the service listens on loopback
# only and holds no credentials — but it keeps the file shape uniform with the
# other two services.

# The GGUF under /opt/bocco-embeddings/models. Q8_0 rather than Q4_K on purpose:
# the 250k-token XLM-RoBERTa vocabulary dominates the file, so Q4_K saves only
# 11 MB of 132 MB while measuring 0.990 cosine agreement with the reference
# weights against Q8_0's 0.9999. Eleven megabytes is not worth a percent of
# retrieval quality on a machine with 14 GB free.
EMBEDDING_MODEL_FILE=multilingual-e5-small-q8_0.gguf

# Must match BRIDGE_CONVERSATION_VECTOR_MODEL in the bridge's own env. The
# bridge stamps every stored vector with this name and refuses to compare
# vectors across names, so a mismatch is a silent no-op, not a wrong answer —
# but it is still a no-op, and re-running the backfill is what fixes it.
EMBEDDING_MODEL_ALIAS=multilingual-e5-small

EMBEDDING_PORT=8646

# Three of the Pi 5's four cores. See the comment in bocco-embeddings.service:
# the fourth is left unasked-for so the bridge's event loop never has to win an
# argument with the scheduler to run.
EMBEDDING_THREADS=3
