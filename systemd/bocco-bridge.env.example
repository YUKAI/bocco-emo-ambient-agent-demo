# Install as /etc/bocco-bridge/bridge.env with owner root:bocco-bridge and mode 0640.
# Use real values only in that installed file; never commit them.
#
# Only BOCCO_WEBHOOK_SECRET is required. Everything below is either an install
# input or a commonly tuned default; the complete list of settings and their
# defaults is in docs/design/bridge-runtime.md.

BOCCO_WEBHOOK_SECRET=replace-at-install-time

# Optional legacy fast path. Set only when API posts use a sender UUID that is
# distinct from every human sender. Shared personal OAuth accounts must leave it unset.
# BOCCO_AGENT_USER_UUID=replace-at-install-time

# Optional robot identity and character. Leave both commented for the current default.
# Use a literal \n inside BRIDGE_PERSONA for multiple instruction lines.
# BRIDGE_ROBOT_NICKNAME=コロン
# Other names the household calls the robot, comma separated, matched only when
# they lead an utterance. A leading name is removed before the fast routes look
# at the question, so an address the bridge does not recognise costs the whole
# route: 「お嬢、今日のニュース教えて」 reached the model, which has no
# headlines, instead of the local news script.
# Script variation does NOT need an entry — 「えもちゃん」 already matches a
# nickname configured as 「エモちゃん」, because kana is folded before comparing.
# BRIDGE_ROBOT_NICKNAME_ALIASES=お嬢,エモ
# BRIDGE_PERSONA="明るく親しみやすい性格です。\n身近なことに好奇心を示します。"

# Motion choreography is enabled by default. Configure the demo room UUID so
# startup can fetch voice_speed once; no settings request is made per reply.
BRIDGE_MOTIONS_ENABLED=true
# A normal Hermes conversation starts with one subtle, motion-only acknowledgment.
BRIDGE_ACK_MOTION=true
BRIDGE_ACK_MOTION_NAME=ALRIGHT_N_0
# How long a motion sent alongside speech takes to reach the device, subtracted
# when scheduling inline cues. Leave it at 0. The live trial in
# docs/design/motion-speech-concurrency.md found the device queues a motion
# until speech ends, so dispatching earlier cannot place a gesture inside the
# utterance — it only detaches the gesture from the words it was computed for.
#BRIDGE_MOTION_TRANSPORT_LAG_SECONDS=0
# BOCCO_ROOM_UUID=replace-at-install-time

# Conservative deterministic skill routes. Empty disables all fast routes.
# Installer places their root-owned shared copies in /usr/local/share/bocco-bridge/fast-skills.
BRIDGE_FAST_ROUTES=weather,time,news
# Used only by the audited weather script and passed without bridge credentials.
DEFAULT_LOCATION=Tokyo

# BOCCO Platform API client. Tokens rotate into BOCCO_TOKEN_FILE after first start.
BOCCO_PLATFORM_BASE_URL=https://platform-api.bocco.me
BOCCO_ACCESS_TOKEN=replace-at-install-time
BOCCO_REFRESH_TOKEN=replace-at-install-time
BOCCO_TOKEN_FILE=/var/lib/bocco-bridge/oauth.json

# Hermes Responses API client inputs. Both services remain on loopback.
HERMES_API_URL=http://127.0.0.1:8642
API_SERVER_KEY=replace-at-install-time
# Hard generation cap for short robot speech across conversation and ambient calls.
HERMES_MAX_OUTPUT_TOKENS=128

BOCCO_BRIDGE_DB=/var/lib/bocco-bridge/state.db
# Optional override; default is memory.db beside BOCCO_BRIDGE_DB.
BOCCO_BRIDGE_MEMORY_DB=/var/lib/bocco-bridge/memory.db
# Retrieval-based conversational memory. OFF by default: nothing is stored, no
# transcript database is created, and Hermes keeps its own unbounded
# conversation. Turn it on to store each completed exchange in the bridge and
# rebuild the prompt from a verbatim recent window plus retrieved older turns.
BRIDGE_CONVERSATION_MEMORY=off
# Optional override; default is transcript.db beside BOCCO_BRIDGE_DB.
#BOCCO_BRIDGE_TRANSCRIPT_DB=/var/lib/bocco-bridge/transcript.db
#BRIDGE_CONVERSATION_RECENT_TURNS=6
#BRIDGE_CONVERSATION_RETRIEVED_TURNS=3
#BRIDGE_CONVERSATION_TURN_MAX_CHARS=120
# Hard cap on the injected conversation section, enforced by construction.
#BRIDGE_CONVERSATION_MAX_CHARS=1200
#BRIDGE_CONVERSATION_RETENTION_TURNS=500
# Semantic retrieval on top of BM25, served by bocco-embeddings.service on
# loopback. OFF by default. Requires BRIDGE_CONVERSATION_MEMORY=on, and
# requires the backfill to have been run — see
# docs/design/semantic-retrieval.md for the whole sequence.
#
# It buys the queries BM25 cannot answer: 「ごはんの話したっけ」 finding the
# stored 「君の好きな食べ物何?」/「あったかいスープが好きだよ」, which share no
# characters at all. It costs nothing when the service is missing: retrieval
# falls back to the lexical path and the reply is unchanged.
BRIDGE_CONVERSATION_VECTORS=off
#BRIDGE_CONVERSATION_VECTOR_URL=http://127.0.0.1:8646
# Must match EMBEDDING_MODEL_ALIAS in /etc/bocco-embeddings/embeddings.env.
# Stored vectors are stamped with this name and never compared across names,
# so changing it means re-running the backfill, not editing the database.
#BRIDGE_CONVERSATION_VECTOR_MODEL=multilingual-e5-small
#BRIDGE_CONVERSATION_VECTOR_DIMS=384
# THE LATENCY GUARANTEE. The query embedding gets this long; past it the reply
# proceeds on BM25 alone. Raising it raises the worst-case reply time by the
# same amount, which is the one thing this feature promised not to do. The
# bridge refuses to start above 0.5.
#BRIDGE_CONVERSATION_VECTOR_QUERY_DEADLINE_SECONDS=0.12
# After this many consecutive misses the bridge stops calling the service for
# the cooldown, so an outage costs three deadlines a minute rather than one per
# reply.
#BRIDGE_CONVERSATION_VECTOR_BREAKER_FAILURES=3
#BRIDGE_CONVERSATION_VECTOR_BREAKER_COOLDOWN_SECONDS=60
# Deadline for embedding a turn on the write side. This one runs in a detached
# task after the reply is already sent, so it is allowed to be generous — it
# never delays a reply.
#BRIDGE_CONVERSATION_VECTOR_WRITE_DEADLINE_SECONDS=5
# Depth of each ranking before Reciprocal Rank Fusion combines them, and the
# ceiling on the brute-force cosine sweep (matches the retention cap).
#BRIDGE_CONVERSATION_VECTOR_CANDIDATES=12
#BRIDGE_CONVERSATION_VECTOR_SCAN_CAP=500
# Cosine floor for admitting a turn to the vector ranking. 0 is off; tune it
# from the live store if weak matches start displacing good lexical hits.
#BRIDGE_CONVERSATION_VECTOR_MIN_SIMILARITY=0.0
# How the Hermes-side conversation is bounded: persistent (default, unchanged),
# rotating (new conversation every ROTATE_TURNS exchanges), or stateless (no
# conversation, no server-side store). Anything but persistent requires
# BRIDGE_CONVERSATION_MEMORY=on.
#BRIDGE_HERMES_CONVERSATION_MODE=persistent
#BRIDGE_HERMES_CONVERSATION_ROTATE_TURNS=10
# Inventing a motion on request ("おどって：うれしい気持ち"). OFF by default:
# the phrase is an ordinary utterance, no repertoire database is created and no
# generation is ever queued. Turn it on and the model emits a compact
# choreography spec, the bridge renders and validates the document, performs it,
# and remembers the spec so the same phrase replays it later.
BRIDGE_MOTION_INVENTION=off
# Optional override; default is repertoire.db beside BOCCO_BRIDGE_DB.
#BOCCO_BRIDGE_REPERTOIRE_DB=/var/lib/bocco-bridge/repertoire.db
# Most recent invented motions kept per room.
#BRIDGE_MOTION_INVENTION_RETENTION=50
# Automatic event extraction. OFF by default: no extraction job is queued, no
# event database is created, and the composed prompt is byte-for-byte what it
# was without this. Turn it on and one background Hermes call per completed
# exchange decides whether anything *happened* — 「今日ミーティングがある」 yes,
# しりとりの「りんご」 and 「今日の天気は？」 no — and writes one dated line, with
# 「いま」「今日」「さっき」 resolved to the moment they were spoken so they cannot
# rot in storage. Requires BRIDGE_CONVERSATION_MEMORY=on.
BRIDGE_EVENT_MEMORY=off
# Optional override; default is events.db beside BOCCO_BRIDGE_DB.
#BOCCO_BRIDGE_EVENT_DB=/var/lib/bocco-bridge/events.db
# How long a finished exchange waits before extraction may run. Keeps the model
# call out of the gap between two sentences of a live conversation.
#BRIDGE_EVENT_EXTRACTION_DELAY_SECONDS=15
# Floor between two extraction calls: this is the third consumer of the single
# background Hermes lane and by far the most frequent one.
#BRIDGE_EVENT_EXTRACTION_MIN_INTERVAL_SECONDS=3
# Retrieval budget. Small on purpose — events supplement transcript retrieval
# and must never crowd it out.
#BRIDGE_EVENT_MEMORY_RECALLED=3
#BRIDGE_EVENT_MEMORY_MAX_CHARS=400
#BRIDGE_EVENT_MEMORY_RETENTION=2000
BOCCO_BRIDGE_ECHO_WINDOW_SECONDS=600
# Default 30 minutes; increase if ambient greetings are still too frequent.
BOCCO_BRIDGE_RADAR_COOLDOWN_SECONDS=1800
# Instant handling-reaction cooldowns (seconds); there is no debounce timer.
BOCCO_BRIDGE_ACCEL_ACTIVE_COOLDOWN_SECONDS=120
BOCCO_BRIDGE_ACCEL_DEFAULT_COOLDOWN_SECONDS=300
# One morning/evening light reaction per room in this window.
BOCCO_BRIDGE_ILLUMINANCE_COOLDOWN_SECONDS=28800
BOCCO_BRIDGE_DEPENDENCY_FACTORY=bocco_bridge.integration:create_dependencies
BOCCO_BRIDGE_TUNNEL_ENABLED=true
BOCCO_BRIDGE_CLOUDFLARED=/usr/bin/cloudflared
# WEBHOOK DELIVERY SELF-HEAL. A quick tunnel gets a new random hostname on every
# start; the Platform API sometimes accepts the new registration and then never
# delivers to it. Nothing errors, nothing is logged, and the robot simply stops
# responding until the service is restarted. On by default: the bridge proves
# delivery is alive by posting a motion document that commands no movement and
# makes no sound, and repairs the registration when the echo does not come back.
# Requires BOCCO_ROOM_UUID and BRIDGE_MOTIONS_ENABLED; off without them.
BRIDGE_WEBHOOK_PROBE=on
# Probe this long after each registration, and after this much total silence.
# Six hours means a genuinely quiet daytime house pays at most two probes.
#BRIDGE_WEBHOOK_PROBE_STARTUP_DELAY_SECONDS=5
#BRIDGE_WEBHOOK_PROBE_SILENCE_SECONDS=21600
# Measured delivery is 2-3s; twenty is deliberate headroom.
#BRIDGE_WEBHOOK_PROBE_TIMEOUT_SECONDS=20
# One detection probe plus at most two repairs (re-register, recycle tunnel).
# 3 is the ceiling as well as the default — there is no remedy after the
# recycle, and a bigger budget could only recycle the tunnel again. Lower it to
# 2 to stop before the recycle, or 1 to detect and report without repairing.
#BRIDGE_WEBHOOK_PROBE_MAX_ATTEMPTS=3
#BRIDGE_WEBHOOK_PROBE_BACKOFF_SECONDS=15
#BRIDGE_WEBHOOK_PROBE_RECYCLE_TIMEOUT_SECONDS=45
# Silence-triggered probes stay inside waking hours; registration-triggered
# probes ignore this window because somebody just restarted the service.
#BRIDGE_WEBHOOK_PROBE_START_HOUR=8
#BRIDGE_WEBHOOK_PROBE_END_HOUR=22
