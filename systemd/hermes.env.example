# Install as /etc/hermes-agent/hermes.env with owner root:hermes-agent and mode 0640.
# Hermes/OpenAI secrets belong here, never in the unit or repository.
# scripts/install-hermes.sh places this file and never overwrites an existing one.

# Required. Obtain from https://platform.openai.com/api-keys — this is the one
# step of the install that cannot be automated, because it costs money and is
# tied to your own account.
OPENAI_API_KEY=replace-at-install-time

# Required. Not obtained from anywhere: choose any long random string. The
# bridge sends it as a bearer token to the loopback Responses API, so the exact
# same value must also be set as API_SERVER_KEY in /etc/bocco-bridge/bridge.env.
#   openssl rand -hex 32
API_SERVER_KEY=replace-at-install-time

API_SERVER_ENABLED=true
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642

# Fallback location for the weather skill when the user names no place. A
# place name or a Japanese postal code; the skill resolves postal codes through
# Zipcloud before geocoding. Must agree with DEFAULT_LOCATION in
# /etc/bocco-bridge/bridge.env, which the deterministic fast route reads.
DEFAULT_LOCATION=Tokyo

# Optional. Without it the finance skill is installed but inert.
# Free key from https://www.alphavantage.co/support/#api-key
#ALPHA_VANTAGE_KEY=replace-at-install-time

# Optional. Without both, the email skill replies "メール連携は未設定です。"
# and exits successfully. GMAIL_APP_PASSWORD must be a Google app password
# (https://myaccount.google.com/apppasswords), never an account password.
#GMAIL_ADDRESS=you@gmail.com
#GMAIL_APP_PASSWORD=replace-at-install-time
